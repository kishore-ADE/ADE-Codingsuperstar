{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ADF-Kishore-dev-CI"
		},
		"LS_ADLS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS'"
		},
		"LS_AzureSQL_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AzureSQL'"
		},
		"LS_OnpremSQL_Adventure_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_OnpremSQL_Adventure'"
		},
		"DS_Source_Rest_JSON_Data_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://jsonplaceholder.typicode.com/"
		},
		"LS_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stkishoredevci.dfs.core.windows.net/"
		},
		"LS_AzureSQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-kishore-dev-ci.database.windows.net"
		},
		"LS_AzureSQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "SQLDB-Kishore-dev-CI"
		},
		"LS_AzureSQL_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "dmmuser"
		},
		"LS_OnpremSQL_Adventure_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "Sahithya_Dasari"
		},
		"LS_OnpremSQL_Adventure_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AdventureWorksLT2019"
		},
		"LS_OnpremSQL_Adventure_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "dbadmin"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ADF-Kishore-dev-CI_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_accountKey": {
						"value": "[parameters('LS_ADLS_accountKey')]"
					},
					"LS_AzureSQL_password": {
						"value": "[parameters('LS_AzureSQL_password')]"
					},
					"LS_OnpremSQL_Adventure_password": {
						"value": "[parameters('LS_OnpremSQL_Adventure_password')]"
					},
					"DS_Source_Rest_JSON_Data_properties_typeProperties_url": {
						"value": "[parameters('DS_Source_Rest_JSON_Data_properties_typeProperties_url')]"
					},
					"LS_ADLS_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_properties_typeProperties_url')]"
					},
					"LS_AzureSQL_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSQL_properties_typeProperties_server')]"
					},
					"LS_AzureSQL_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSQL_properties_typeProperties_database')]"
					},
					"LS_AzureSQL_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzureSQL_properties_typeProperties_userName')]"
					},
					"LS_OnpremSQL_Adventure_properties_typeProperties_server": {
						"value": "[parameters('LS_OnpremSQL_Adventure_properties_typeProperties_server')]"
					},
					"LS_OnpremSQL_Adventure_properties_typeProperties_database": {
						"value": "[parameters('LS_OnpremSQL_Adventure_properties_typeProperties_database')]"
					},
					"LS_OnpremSQL_Adventure_properties_typeProperties_userName": {
						"value": "[parameters('LS_OnpremSQL_Adventure_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}